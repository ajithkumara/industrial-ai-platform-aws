# Copy this to backend.hcl and fill in your values.
# backend.hcl is git-ignored (no account IDs committed).
#
# Get these values from `terraform output` in terraform/bootstrap/ after running bootstrap.

bucket         = "iap-tf-state-<YOUR_ACCOUNT_ID>"   # bootstrap output: state_bucket_name
key            = "dev-stage1/terraform.tfstate"
region         = "ca-central-1"
use_lockfile   = true
# dynamodb_table is deprecated in Terraform >= 1.10. use_lockfile stores the lock in S3.
# If using an older Terraform version, replace use_lockfile with:
#   dynamodb_table = "iap-tf-lock"   # bootstrap output: lock_table_name
encrypt        = true
